{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giga-user.local/contracts/scientific-study-extraction.v1.schema.json",
  "title": "GIGA human-verified full-text study extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "group_id",
    "full_text_sha256",
    "full_text_verified",
    "study_design",
    "population",
    "condition",
    "intervention_protocol",
    "comparator",
    "sample_size",
    "outcomes",
    "effect_estimates",
    "follow_up",
    "adverse_events",
    "withdrawals",
    "funding",
    "conflicts",
    "risk_of_bias",
    "population_applicability",
    "source_locators",
    "extracted_by",
    "extracted_at",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "giga.scientific-study-extraction.v1"
    },
    "group_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "full_text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "full_text_verified": {
      "const": true
    },
    "study_design": {
      "type": "string",
      "minLength": 1
    },
    "population": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "type": "string",
      "minLength": 1
    },
    "intervention_protocol": {
      "type": "string",
      "minLength": 1
    },
    "comparator": {
      "type": "string",
      "minLength": 1
    },
    "sample_size": {
      "type": "integer",
      "minimum": 1
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "effect_estimates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "follow_up": {
      "type": "string",
      "minLength": 1
    },
    "adverse_events": {
      "type": "string",
      "minLength": 1
    },
    "withdrawals": {
      "type": "string",
      "minLength": 1
    },
    "funding": {
      "type": "string",
      "minLength": 1
    },
    "conflicts": {
      "type": "string",
      "minLength": 1
    },
    "risk_of_bias": {
      "enum": ["low", "some_concerns", "high", "critical", "unclear"]
    },
    "population_applicability": {
      "enum": ["direct", "partial", "indirect", "unknown"]
    },
    "source_locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extracted_by": {
      "type": "string",
      "minLength": 1
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
