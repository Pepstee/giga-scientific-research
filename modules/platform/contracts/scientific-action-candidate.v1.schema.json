{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giga-user.local/contracts/scientific-action-candidate.v1.schema.json",
  "title": "GIGA non-authoritative scientific action-planning candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question",
    "intervention",
    "risk_class",
    "source_record_ids",
    "readiness",
    "authority_level",
    "recommendation_authority",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "giga.scientific-action-candidate.v1"},
    "question": {"type": "string", "minLength": 1},
    "intervention": {"type": "string", "minLength": 1},
    "risk_class": {
      "enum": ["low_risk_lifestyle", "health_information", "clinical"]
    },
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ready_for_plan",
        "ready_for_execution",
        "recommendation_authority",
        "gates",
        "failed_gates",
        "evidence_summary",
        "boundary"
      ],
      "properties": {
        "status": {"enum": ["blocked", "ready_for_plan"]},
        "ready_for_plan": {"type": "boolean"},
        "ready_for_execution": {"const": false},
        "recommendation_authority": {"const": false},
        "gates": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        },
        "failed_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_summary": {"type": "object"},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "authority_level": {"const": "A0"},
    "recommendation_authority": {"const": false},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
