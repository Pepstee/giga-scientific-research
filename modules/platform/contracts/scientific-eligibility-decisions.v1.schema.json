{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giga-user.local/contracts/scientific-eligibility-decisions.v1.schema.json",
  "title": "Hash-bound human abstract-screening decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "decisions"],
  "properties": {
    "schema_version": {
      "const": "giga.scientific-eligibility-decisions.v1"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "decision",
          "reason_codes",
          "reviewed_by",
          "reviewed_at",
          "abstract_sha256"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decision": {
            "enum": ["include", "exclude"]
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewed_by": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "abstract_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
