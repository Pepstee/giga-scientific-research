{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giga.local/contracts/scientific-search-ontology.v1.schema.json",
  "title": "Scientific search ontology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ontology_id",
    "version",
    "conditions",
    "interventions",
    "outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": "giga.scientific-search-ontology.v1"
    },
    "ontology_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,159}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "conditions": {
      "$ref": "#/$defs/conceptMap"
    },
    "interventions": {
      "$ref": "#/$defs/conceptMap"
    },
    "outcomes": {
      "$ref": "#/$defs/conceptMap"
    }
  },
  "$defs": {
    "conceptMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,79}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["terms"],
        "properties": {
          "terms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "subject_headings": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    }
  }
}
